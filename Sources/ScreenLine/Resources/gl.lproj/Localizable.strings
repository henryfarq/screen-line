/* Galician. */

/* AppDelegate */
"Let Screen Line handle your screenshots?" = "Queres que Screen Line se encargue das túas capturas?";
"Screenshots will hang on the line the instant you take them, without the floating thumbnail, and will not pile up on your Desktop. Drag one to a folder to keep it, or discard it with the cross. You can turn this off from the menu bar, and your settings come back when Screen Line quits." = "As capturas penduraranse na corda no intre en que as fagas, sen a miniatura flotante, e non se amontoarán no Escritorio. Arrastra unha a un cartafol para gardala, ou descártaa coa cruz. Podes desactivalo dende a barra de menús, e os teus axustes volven ser os de antes ao saír de Screen Line.";
"Turn on" = "Activar";
"Not now" = "Agora non";
"Quit Screen Line" = "Saír de Screen Line";
"Could not change the login setting" = "Non se puido cambiar o inicio de sesión";
"Move Screen Line to the Applications folder and try again." = "Move Screen Line ao cartafol Aplicacións e téntao de novo.";
"Watch" = "Vixiar";
"New images saved to this folder will hang on the line." = "As imaxes novas que se garden neste cartafol penduraranse na corda.";
