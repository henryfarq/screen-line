/* Spanish. */

/* AppDelegate */
"Let Screen Line handle your screenshots?" = "¿Quieres que Screen Line se encargue de tus capturas?";
"Screenshots will hang on the line the instant you take them, without the floating thumbnail, and will not pile up on your Desktop. Drag one to a folder to keep it, or discard it with the cross. You can turn this off from the menu bar, and your settings come back when Screen Line quits." = "Las capturas se colgarán al instante, sin la miniatura flotante, y no se acumularán en el Escritorio. Arrastra una a una carpeta para guardarla, o descártala con la cruz. Puedes desactivarlo desde la barra de menús, y tus ajustes vuelven a ser los de antes al salir de Screen Line.";
"Turn on" = "Activar";
"Not now" = "Ahora no";
"Quit Screen Line" = "Salir de Screen Line";
"Could not change the login setting" = "No se pudo cambiar el inicio de sesión";
"Move Screen Line to the Applications folder and try again." = "Mueve Screen Line a la carpeta Aplicaciones y vuelve a intentarlo.";
"Watch" = "Vigilar";
"New images saved to this folder will hang on the line." = "Las imágenes nuevas que se guarden en esta carpeta se colgarán en la cuerda.";
"Change Shortcut" = "Cambiar atajo";
"Space" = "Espacio";
"Press the new shortcut" = "Pulsa el nuevo atajo";
"Escape cancels. Delete removes the shortcut." = "Escape cancela. Borrar quita el atajo.";
"The line is empty" = "La cuerda está vacía";
"%d on the line" = "%d en la cuerda";

